version: "3.0"
metadata:
  component: "Sovereign-Cloud-Compliance-Engine"
  governance: "Cross-Border-Data-Autonomy"

regional_compliance_matrix:
  - region: "EU-EUROPE"
    legal_frameworks: ["GDPR", "BDSG_Germany"]
    data_localization:
      strict_containment: true # Absolutely zero outbound raw data transmission allowed outside the EU zone
      tenant_vetting_level: "High-Sovereign-Only"
    hardware_slicing_override:
      encryption_standard: "AES-256-GCM-Confidential-Compute" # Forces Blackwell GPUs into unreadable execution mode
      network_egress_routing: "AWS-European-Sovereign-Cloud-Gateway"

  - region: "US-DOMESTIC"
    legal_frameworks: ["DTSA", "TUTSA_Texas"]
    data_localization:
      strict_containment: false
      tenant_vetting_level: "Standard-Enterprise"
    hardware_slicing_override:
      encryption_standard: "Standard-NVLink-Fabric"
      network_egress_routing: "Default-US-East-Backbone"

  - region: "IN-APAC"
    legal_frameworks: ["DPDP_Act_India"]
    data_localization:
      strict_containment: true
      tenant_vetting_level: "National-Infrastructure-Only"
    hardware_slicing_override:
      encryption_standard: "AES-256-GCM-Confidential-Compute"
      network_egress_routing: "NxtGen-Sovereign-Data-Center-Fabric"
